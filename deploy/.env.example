# Copy to deploy/.env (gitignored) only if you need one of these. Both are optional.

# A Tailscale auth key (admin console -> Settings -> Keys). Without it, the tailscale container prints a sign-in link once.
TS_AUTHKEY=

# The port on this computer for http://localhost:<port>. Change it if `python whistlecode/whistlecode.py serve` runs too.
LOCAL_PORT=8000
