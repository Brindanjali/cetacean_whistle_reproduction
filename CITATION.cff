license: Apache-2.0
version: 0.10.0
date-released: 2026-11-22
repository-code: "https://github.com/anonymus-k-dot/cetacean_whistle_reproduction"
keywords:
  - bioacoustics
  - cetacean whistles
  - variational autoencoder
  - gaussian mixture model
  - biomimetic underwater communication
