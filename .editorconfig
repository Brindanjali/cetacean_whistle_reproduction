# Editor settings shared by every editor that reads EditorConfig (VS Code with the extension, JetBrains, ...).
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,toml}]
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json,js,css,html}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[.githooks/*]
end_of_line = lf
